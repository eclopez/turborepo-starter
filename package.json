{
  "name": "turborepo-starter",
  "version": "1.0.0",
  "private": true,
  "author": "Erik Lopez",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.5",
      "onFail": "error"
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js-pure"
    ],
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "npm_config_loglevel=error npm_config_force=true turbo gen",
    "lint": "turbo run lint:repo",
    "lint:repo": "oxlint --type-aware",
    "lint:fix": "turbo run lint:repo:fix",
    "lint:repo:fix": "oxlint --type-aware --fix",
    "prepare": "husky",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.8.4",
    "turbo": "2.9.18"
  }
}
